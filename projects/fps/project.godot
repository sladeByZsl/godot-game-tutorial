[layer_names]

3d_physics/layer_1="世界"
3d_physics/layer_2="玩家"
3d_physics/layer_3="敌人"
3d_physics/layer_4="碎片"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/msaa_3d=1
textures/default_filters/anisotropic_filtering_level=2

[gui]

theme/custom_font="res://fonts/ui_font.ttf"
