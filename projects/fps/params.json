{
  "title": "第一人称射击",
  "order": 6,
  "summary": "Compatibility 渲染器下的小型 FPS：第一人称控制器、射线武器、运行时烘焙导航网格的追击敌人。",
  "tags": [
    "CharacterBody3D",
    "射线检测",
    "NavigationAgent3D",
    "WorldEnvironment"
  ],
  "controls": "先点击画面锁定鼠标（Esc 释放）。鼠标转视角，左键开火，WASD 移动，Shift 冲刺，空格跳，Ctrl/C 蹲，R 换弹，1/2/Q 切枪",
  "groups": [
    {
      "name": "视角",
      "params": [
        {
          "key": "player.mouse_sensitivity",
          "label": "鼠标灵敏度",
          "type": "float",
          "min": 0.02,
          "max": 0.5,
          "step": 0.01,
          "default": 0.12,
          "unit": "°/px",
          "desc": "鼠标每移动 1 像素，视角转多少度"
        },
        {
          "key": "player.invert_y",
          "label": "反转 Y 轴",
          "type": "bool",
          "default": false
        },
        {
          "key": "player.fov",
          "label": "视野角 FOV",
          "type": "float",
          "min": 40,
          "max": 110,
          "step": 1,
          "default": 75,
          "unit": "°",
          "desc": "垂直视野角。越大看得越广，边缘拉伸越明显"
        },
        {
          "key": "player.sprint_fov",
          "label": "冲刺 FOV",
          "type": "float",
          "min": 40,
          "max": 120,
          "step": 1,
          "default": 86,
          "unit": "°",
          "desc": "冲刺时 FOV 平滑过渡到这个值，制造速度感"
        }
      ]
    },
    {
      "name": "移动",
      "params": [
        {
          "key": "player.walk_speed",
          "label": "移动速度",
          "type": "float",
          "min": 1,
          "max": 15,
          "step": 0.5,
          "default": 5,
          "unit": "m/s"
        },
        {
          "key": "player.sprint_mult",
          "label": "冲刺倍率",
          "type": "float",
          "min": 1,
          "max": 3,
          "step": 0.1,
          "default": 1.6
        },
        {
          "key": "player.acceleration",
          "label": "加速度",
          "type": "float",
          "min": 5,
          "max": 150,
          "step": 5,
          "default": 45,
          "unit": "m/s²",
          "desc": "太小会像在冰面上；很大时起步、转向都是瞬间完成"
        },
        {
          "key": "player.air_control",
          "label": "空中操控",
          "type": "float",
          "min": 0,
          "max": 1,
          "step": 0.05,
          "default": 0.3,
          "desc": "空中加速度占地面的比例。0 = 起跳后完全不能改方向"
        },
        {
          "key": "player.jump_velocity",
          "label": "起跳速度",
          "type": "float",
          "min": 2,
          "max": 12,
          "step": 0.2,
          "default": 5.2,
          "unit": "m/s",
          "desc": "跳跃高度 = v² / 2g"
        },
        {
          "key": "player.gravity",
          "label": "重力",
          "type": "float",
          "min": 2,
          "max": 40,
          "step": 0.5,
          "default": 14,
          "unit": "m/s²"
        }
      ]
    },
    {
      "name": "镜头晃动",
      "params": [
        {
          "key": "player.bob_amount",
          "label": "晃动幅度",
          "type": "float",
          "min": 0,
          "max": 0.2,
          "step": 0.005,
          "default": 0.05,
          "unit": "m",
          "desc": "0 = 关闭 head bob"
        },
        {
          "key": "player.bob_freq",
          "label": "晃动频率",
          "type": "float",
          "min": 0.3,
          "max": 4,
          "step": 0.1,
          "default": 1.3,
          "unit": "rad/m",
          "desc": "每走 1 米相位前进多少弧度"
        }
      ]
    },
    {
      "name": "步枪",
      "params": [
        {
          "key": "rifle.fire_rate",
          "label": "射速",
          "type": "float",
          "min": 1,
          "max": 25,
          "step": 1,
          "default": 10,
          "unit": "发/秒"
        },
        {
          "key": "rifle.recoil",
          "label": "后坐力",
          "type": "float",
          "min": 0,
          "max": 5,
          "step": 0.1,
          "default": 1.2,
          "unit": "°",
          "desc": "每发让视角上跳多少度"
        },
        {
          "key": "rifle.spread",
          "label": "基础散布",
          "type": "float",
          "min": 0,
          "max": 6,
          "step": 0.1,
          "default": 0.6,
          "unit": "°",
          "desc": "站着不动、第一发时弹道偏离准星的最大角度"
        },
        {
          "key": "rifle.spread_per_shot",
          "label": "连射散布增量",
          "type": "float",
          "min": 0,
          "max": 2,
          "step": 0.05,
          "default": 0.45,
          "unit": "°",
          "desc": "每开一枪散布增加多少，停火后恢复"
        },
        {
          "key": "weapon.hit_method",
          "label": "射线检测方式",
          "type": "enum",
          "options": [
            "intersect_ray",
            "RayCast3D"
          ],
          "default": "intersect_ray",
          "desc": "两种写法效果相同，可以对照源码"
        }
      ]
    },
    {
      "name": "敌人",
      "params": [
        {
          "key": "spawner.count",
          "label": "敌人数量",
          "type": "int",
          "min": 0,
          "max": 12,
          "step": 1,
          "default": 5
        },
        {
          "key": "enemy.move_speed",
          "label": "敌人速度",
          "type": "float",
          "min": 0.5,
          "max": 8,
          "step": 0.1,
          "default": 3.2,
          "unit": "m/s"
        },
        {
          "key": "enemy.sight_range",
          "label": "敌人视野距离",
          "type": "float",
          "min": 3,
          "max": 50,
          "step": 1,
          "default": 22,
          "unit": "m"
        }
      ]
    },
    {
      "name": "调试与画面",
      "params": [
        {
          "key": "debug.nav",
          "label": "显示导航网格和路径",
          "type": "bool",
          "default": false
        },
        {
          "key": "debug.rays",
          "label": "显示射线",
          "type": "bool",
          "default": false,
          "desc": "黄色 = 你的子弹；绿/红 = 敌人的视线（看得见/被挡住）"
        },
        {
          "key": "world.fog_density",
          "label": "雾密度",
          "type": "float",
          "min": 0,
          "max": 0.08,
          "step": 0.002,
          "default": 0.006
        },
        {
          "key": "world.shadows",
          "label": "太阳阴影",
          "type": "bool",
          "default": true
        },
        {
          "key": "world.time_scale",
          "label": "时间缩放",
          "type": "float",
          "min": 0.1,
          "max": 2,
          "step": 0.05,
          "default": 1,
          "desc": "Engine.time_scale：小于 1 就是子弹时间"
        }
      ]
    }
  ],
  "actions": [
    {
      "name": "restart",
      "label": "重新开始"
    },
    {
      "name": "spawn_enemy",
      "label": "生成敌人"
    },
    {
      "name": "switch_weapon",
      "label": "切换武器"
    }
  ],
  "touch": {
    "stick": {
      "left": "move_left",
      "right": "move_right",
      "up": "move_forward",
      "down": "move_back"
    },
    "look": true,
    "buttons": [
      {
        "action": "fire",
        "label": "开火"
      },
      {
        "action": "jump",
        "label": "跳"
      },
      {
        "action": "reload",
        "label": "换弹"
      },
      {
        "action": "weapon_switch",
        "label": "换枪"
      },
      {
        "action": "crouch",
        "label": "蹲"
      },
      {
        "action": "sprint",
        "label": "冲刺"
      }
    ],
    "bottom": 17
  }
}
