[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="water"
2d_physics/layer_3="player"
2d_physics/layer_4="enemy"
2d_physics/layer_5="player_attack"
2d_physics/layer_6="enemy_attack"
2d_physics/layer_7="interact"
2d_physics/layer_8="pickup"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.15, 0.13, 0.2, 1)

[gui]

theme/custom_font="res://fonts/ui_font.ttf"
