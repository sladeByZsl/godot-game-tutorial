[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://ui/title.gd" id="1"]
[ext_resource type="PackedScene" path="res://game/starfield.tscn" id="2"]
[ext_resource type="Environment" path="res://ui/neon_env.tres" id="3"]
[ext_resource type="PackedScene" path="res://ui/settings_panel.tscn" id="4"]

[node name="Title" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = ExtResource("3")

[node name="Starfield" parent="." instance=ExtResource("2")]

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 64
theme_override_constants/margin_top = 48
theme_override_constants/margin_right = 64
theme_override_constants/margin_bottom = 40

[node name="HBox" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 40

[node name="Left" type="VBoxContainer" parent="Margin/HBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="Logo" type="Label" parent="Margin/HBox/Left"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "NEON STRIKE"

[node name="Sub" type="Label" parent="Margin/HBox/Left"]
layout_mode = 2
theme_type_variation = &"SubtitleLabel"
text = "霓虹打击 · 《Godot 4.7 互动教程》太空射击示例"

[node name="Gap" type="Control" parent="Margin/HBox/Left"]
custom_minimum_size = Vector2(0, 28)
layout_mode = 2

[node name="Menu" type="VBoxContainer" parent="Margin/HBox/Left"]
unique_name_in_owner = true
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
size_flags_horizontal = 0

[node name="Start" type="Button" parent="Margin/HBox/Left/Menu"]
unique_name_in_owner = true
layout_mode = 2
text = "开始游戏"

[node name="Boss" type="Button" parent="Margin/HBox/Left/Menu"]
unique_name_in_owner = true
layout_mode = 2
text = "直接挑战 Boss"

[node name="Settings" type="Button" parent="Margin/HBox/Left/Menu"]
unique_name_in_owner = true
layout_mode = 2
text = "音量设置"

[node name="Quit" type="Button" parent="Margin/HBox/Left/Menu"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DangerButton"
text = "退出"

[node name="SettingsPanel" parent="Margin/HBox/Left" instance=ExtResource("4")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0

[node name="Spacer" type="Control" parent="Margin/HBox/Left"]
layout_mode = 2
size_flags_vertical = 3

[node name="Hint" type="Label" parent="Margin/HBox/Left"]
layout_mode = 2
theme_type_variation = &"SubtitleLabel"
text = "↑ ↓ 选择　Enter / 空格 确认　手柄：十字键 + A 键"

[node name="Right" type="PanelContainer" parent="Margin/HBox"]
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
size_flags_vertical = 4

[node name="VBox" type="VBoxContainer" parent="Margin/HBox/Right"]
layout_mode = 2

[node name="Header" type="Label" parent="Margin/HBox/Right/VBox"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "最高分"

[node name="Scores" type="VBoxContainer" parent="Margin/HBox/Right/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4

[node name="Sep" type="HSeparator" parent="Margin/HBox/Right/VBox"]
layout_mode = 2

[node name="Help" type="Label" parent="Margin/HBox/Right/VBox"]
layout_mode = 2
theme_type_variation = &"HudSmall"
text = "方向键 / WASD　移动
空格 / J　射击（按住连发）
X / K　炸弹：清除全部敌弹
Shift　低速移动，显示判定点
Esc / P　暂停"
