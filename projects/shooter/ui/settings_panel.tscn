[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/settings_panel.gd" id="1"]

[node name="SettingsPanel" type="PanelContainer"]
custom_minimum_size = Vector2(420, 0)
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "音量设置"
horizontal_alignment = 1

[node name="Grid" type="GridContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/h_separation = 14
theme_override_constants/v_separation = 14
columns = 3

[node name="MusicLabel" type="Label" parent="VBox/Grid"]
layout_mode = 2
text = "音乐"

[node name="MusicSlider" type="HSlider" parent="VBox/Grid"]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 24)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
max_value = 1.0
step = 0.05
value = 0.6

[node name="MusicValue" type="Label" parent="VBox/Grid"]
unique_name_in_owner = true
custom_minimum_size = Vector2(52, 0)
layout_mode = 2
text = "60%"
horizontal_alignment = 2

[node name="SfxLabel" type="Label" parent="VBox/Grid"]
layout_mode = 2
text = "音效"

[node name="SfxSlider" type="HSlider" parent="VBox/Grid"]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 24)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
max_value = 1.0
step = 0.05
value = 0.8

[node name="SfxValue" type="Label" parent="VBox/Grid"]
unique_name_in_owner = true
custom_minimum_size = Vector2(52, 0)
layout_mode = 2
text = "80%"
horizontal_alignment = 2

[node name="Hint" type="Label" parent="VBox"]
layout_mode = 2
theme_type_variation = &"SubtitleLabel"
text = "← → 调节，↑ ↓ 切换，Esc 返回"
horizontal_alignment = 1

[node name="Back" type="Button" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
custom_minimum_size = Vector2(160, 0)
text = "返回"
